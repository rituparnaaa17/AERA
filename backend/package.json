{
  "name": "@cognisafe/backend",
  "version": "1.0.0",
  "private": true,
  "description": "COGNISAFE-Q AWS Serverless Backend — CDK + Lambda + DynamoDB + Cognito + SNS",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --require-approval never",
    "destroy": "cdk destroy"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "aws-cdk": "^2.174.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.7.3"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.723.0",
    "@aws-sdk/client-dynamodb": "^3.723.0",
    "@aws-sdk/client-sns": "^3.723.0",
    "@aws-sdk/lib-dynamodb": "^3.723.0",
    "aws-cdk-lib": "^2.174.0",
    "constructs": "^10.4.2",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  }
}
