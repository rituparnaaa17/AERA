# COGNISAFE-Q Backend Environment Variables
# Copy to .env and fill in values after running `npx cdk deploy`

# AWS Deployment
AWS_ACCOUNT_ID=123456789012
CDK_DEFAULT_REGION=ap-south-1

# DEMO MODE: true = log notifications to CloudWatch instead of sending real SMS
# Set to false only after completing Indian DLT SMS registration
DEMO_MODE=true
