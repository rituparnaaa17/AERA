{
  "expo": {
    "name": "AERA",
    "slug": "aera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/aera-icon.png",
    "scheme": "aera",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1E"
    },
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/images/aera-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/aera-icon.png",
        "backgroundColor": "#0A0F1E"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
