# COGNISAFE-Q Mobile App — Environment Variables
# Copy to .env in artifacts/cognisafe-q/ and fill in after running `npx cdk deploy`
#
# Values from CDK deploy outputs (printed in terminal after deploy):
#   Outputs:
#     CognisafeStack.ApiBaseUrl = https://xxxx.execute-api.ap-south-1.amazonaws.com
#     CognisafeStack.UserPoolId = ap-south-1_XXXXXXXXX
#     CognisafeStack.UserPoolClientId = xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Gateway base URL (from CDK output: CognisafeStack.ApiBaseUrl)
EXPO_PUBLIC_API_GATEWAY_URL=https://REPLACE_WITH_CDK_OUTPUT.execute-api.ap-south-1.amazonaws.com

# Cognito User Pool (from CDK output: CognisafeStack.UserPoolId)
EXPO_PUBLIC_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX

# Cognito App Client ID (from CDK output: CognisafeStack.UserPoolClientId)
EXPO_PUBLIC_COGNITO_CLIENT_ID=REPLACE_WITH_CDK_OUTPUT

# Cognito Region (must match your CDK deployment region)
EXPO_PUBLIC_COGNITO_REGION=ap-south-1
