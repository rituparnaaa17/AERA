# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ── Compiled / build output ───────────────────────────────────────────
dist
tmp
out-tsc
build/
web-build/
cdk.out/
backend/cdk.out/
*.tsbuildinfo

# ── Expo / React Native ───────────────────────────────────────────────
.expo/
.expo-shared/
# expo-env.d.ts is regenerated by Expo on every install; keeping it in
# git leads to noisy diffs across dev machines.
expo-env.d.ts
.metro-cache/
.metro-health-check*

# Prebuild output (only track if you commit the native folders yourself)
# android/build/
# ios/build/
# ios/Pods/

# ── Dependencies ──────────────────────────────────────────────────────
node_modules
.pnpm-store

# ── IDE / editor ──────────────────────────────────────────────────────
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode (keep the recommended team settings, drop the rest)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── Coverage / test output ────────────────────────────────────────────
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# ── Logs & temp ───────────────────────────────────────────────────────
*.log
*.tmp

# ── OS metadata ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Cursor / Nx tooling (existing) ────────────────────────────────────
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# ── Replit ────────────────────────────────────────────────────────────
.cache/
.local/

# ── Secrets & environment ─────────────────────────────────────────────
# Real env values must never enter git; example templates may.
.env
.env.*
!.env.example
!.env.template
!.env.sample

# Native signing / keystores / credentials
*.keystore
*.jks
*.p8
*.p12
*.pfx
*.pem
*.key
*.cer
*.der
credentials.json
service-account*.json
google-services.json
GoogleService-Info.plist

# ── Local design references (not required by the running app) ────────
# These are inspiration/reference PNGs that live only on the design
# machine; the app copies what it needs into artifacts/*/assets/.
ui-reference/
